# Forces mock mode for the Playwright suite.
#
# Vite loads env files in the order .env -> .env.local -> .env.[mode], with
# later files winning, so this deliberately overrides a developer's .env.local.
# Without it, anyone holding live Supabase credentials fails all 7 specs: the
# app would query the real project instead of the seeded dataset the specs
# assert against.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DEFAULT_CENTER_ID=
